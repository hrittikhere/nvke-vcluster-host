# Local gcloud target. The existing VM is reused if it is running.
NVKE_PROJECT=hrittik-project
NVKE_ZONE=us-central1-a
NVKE_VM=nvke-blog-demo
NVKE_MACHINE=e2-custom-12-24576
NVKE_DISK_GB=400
NVKE_NETWORK=default
# Optional subnet for a custom VPC. Empty uses the network's default subnet.
NVKE_SUBNET=
# Set to 1 to connect through IAP. Requires IAP permissions and an existing
# firewall rule allowing TCP 22 from 35.235.240.0/20 to this VM.
NVKE_USE_IAP=0

# Reviewed upstream commit, rather than a moving branch.
NVKE_REF=5293831ce0eb1ec3f8864b2fd8b53a6621a83cc8
NVKE_CLUSTER=nvke-demo
NVKE_TILT_VERSION=0.37.8
# kubectl 1.35 can talk to the 1.36 management and 1.34 workload APIs.
NVKE_KUBECTL_VERSION=v1.35.0
# vCluster CLI installed on the VM for connecting the workload cluster to vCluster Platform.
NVKE_VCLUSTER_VERSION=0.37.6
# Default storage class for the workload cluster. NVKE's mock lab ships no
# provisioner, so vCluster control planes (and any other PVC) stay Pending
# without one. The manifest checksum pins the exact pinned release content.
NVKE_LOCAL_PATH_VERSION=v0.0.30
NVKE_LOCAL_PATH_SHA256=fe682186b00400fe7e2b72bae16f63e47a56a6dcc677938c6642139ef670045e
# metrics-server serves the Metrics API (kubectl top, autoscalers). The release
# manifest is applied unchanged and verified against this checksum.
NVKE_METRICS_SERVER_VERSION=v0.9.0
NVKE_METRICS_SERVER_SHA256=1cec29a5267809306a2c6ec74a3e449abbb705b4a8beed0c8a1963910f72c79b
NVKE_READY_TIMEOUT=5400

# Laptop ports; change these if another application uses them.
NVKE_LOCAL_API_PORT=8080
NVKE_LOCAL_TILT_PORT=10350
NVKE_LOCAL_K8S_PORT=8443
