# Additional NVKE site. Run with: NVKE_CONFIG=sites/eu-west4.env ./nvke-gcp.sh up
# Inherits every pin and default from the base config, then overrides the
# target, cluster name, local state and laptop ports so sites never collide.
source "$KIT_DIR/config.env"
NVKE_ZONE=europe-west4-a
NVKE_VM=nvke-blog-eu-west4
NVKE_CLUSTER=nvke-eu
NVKE_STATE_DIR="$KIT_DIR/.state/sites/eu-west4"
NVKE_LOCAL_API_PORT=18080
NVKE_LOCAL_TILT_PORT=11350
NVKE_LOCAL_K8S_PORT=18443
