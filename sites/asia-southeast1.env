# Additional NVKE site. Run with: NVKE_CONFIG=sites/asia-southeast1.env ./nvke-gcp.sh up
# Inherits every pin and default from the base config, then overrides the
# target, cluster name, local state and laptop ports so sites never collide.
source "$KIT_DIR/config.env"
NVKE_ZONE=asia-southeast1-b
NVKE_VM=nvke-blog-asia-southeast1
NVKE_CLUSTER=nvke-asia
NVKE_STATE_DIR="$KIT_DIR/.state/sites/asia-southeast1"
NVKE_LOCAL_API_PORT=28080
NVKE_LOCAL_TILT_PORT=21350
NVKE_LOCAL_K8S_PORT=28443
